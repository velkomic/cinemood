      "css": ".ds-save{font-family:\"DM Sans\",sans-serif;cursor:pointer;min-height:40px;transition:background-color 160ms ease-out,color 160ms ease-out;border:0;border-radius:7px;background:var(--save-bg, #22375f);color:var(--save-ink, #e0e9ff);padding:9px 14px;font-size:13px;font-weight:600}.ds-save:hover:not(:disabled){background:var(--save-hover, #304d80)}.ds-save:focus-visible{outline:2px solid var(--accent-hover, #a2bcff);outline-offset:5px}.ds-save:disabled{opacity:.65;cursor:default}"
