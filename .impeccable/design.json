    {
      "name": "Request band",
      "kind": "input",
      "refersTo": "request-band",
      "description": "Transparent request field inside its tinted functional surface.",
      "html": "<div class=\"ds-band\"><label for=\"ds-request\">What would you like to watch?</label><textarea id=\"ds-request\" rows=\"1\" placeholder=\"A mood, a theme, a story you\u2019re looking for\u2026\"></textarea></div>",
      "css": ".ds-band{display:flex;align-items:center;gap:20px;padding:10px 16px;background:var(--surface, #141e35);border-radius:12px;font-family:\"DM Sans\",sans-serif}.ds-band label{font-size:13px;color:var(--muted, #b4c1dc)}.ds-band textarea{min-height:38px;max-height:160px;width:100%;background:transparent;color:var(--ink, #f1f4ff);border:0;resize:vertical;font-family:inherit;font-size:17px;line-height:1.5;padding:5px 0;caret-color:var(--accent, #759dff)}.ds-band textarea::placeholder{color:var(--muted, #b4c1dc);opacity:1}.ds-band textarea:focus{outline:0;border-bottom:1px solid var(--accent, #759dff)}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Active-page accent underline with muted adjacent links.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><a href=\"#discover\" aria-current=\"page\">Discover</a><a href=\"#collection\">My collection</a></nav>",
      "css": ".ds-nav{display:flex;gap:35px;height:60px;font:15px \"DM Sans\",sans-serif}.ds-nav a{display:flex;align-items:center;padding-top:3px;border-bottom:3px solid transparent;text-decoration:none;color:var(--muted, #b4c1dc);transition:color 160ms ease-out}.ds-nav a[aria-current=\"page\"]{color:var(--ink, #f1f4ff);border-color:var(--accent, #759dff)}.ds-nav a:hover{color:var(--ink, #f1f4ff)}.ds-nav a:focus-visible{outline:2px solid var(--accent-hover, #a2bcff);outline-offset:5px}"
    },
    {
      "name": "Film entry",
      "kind": "card",
      "description": "Open comparison entry with the implemented missing-poster fallback.",
      "html": "<article class=\"ds-film\"><button class=\"ds-poster\" aria-label=\"Open film details\"><strong>Film title</strong><small>Poster unavailable</small></button><h2>Film title</h2><p>2024 \u00b7 112 min \u00b7 Drama</p></article>",
      "css": ".ds-film{max-width:420px;font-family:\"DM Sans\",sans-serif;color:var(--ink, #f1f4ff)}.ds-poster{font-family:\"DM Sans\",sans-serif;cursor:pointer;min-height:40px;transition:background-color 160ms ease-out,color 160ms ease-out;display:flex;flex-direction:column;justify-content:end;align-items:start;gap:14px;width:100%;height:clamp(170px,26svh,225px);padding:24px;border:0;border-radius:12px;background:var(--surface-raised, #1d2b49);color:var(--ink, #f1f4ff);text-align:left}.ds-poster strong{font-family:Manrope,sans-serif;font-size:20px;line-height:1.25;letter-spacing:-.025em}.ds-poster small{font-size:12px;color:var(--muted, #b4c1dc)}.ds-poster:hover{outline:1px solid var(--accent, #759dff);outline-offset:-1px}.ds-poster:focus-visible{outline:2px solid var(--accent-hover, #a2bcff);outline-offset:5px}.ds-film h2{font-family:Manrope,sans-serif;font-size:17px;line-height:1.3;letter-spacing:-.025em;margin:12px 0 5px}.ds-film p{font-size:12px;line-height:1.6;color:var(--muted, #b4c1dc);font-variant-numeric:tabular-nums;margin:0 0 16px}"
