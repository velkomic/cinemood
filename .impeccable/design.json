  "narrative": {
    "northStar": "Screening lounge refined",
    "overview": "Screening lounge refined: compact requests, four refreshable spotlight films, five comparable recommendations and inline catalog details. Existing blue-black, navy, periwinkle, Manrope and DM Sans remain the visual language.",
    "keyCharacteristics": [
      "Compact five-film comparison.",
      "Four refreshable spotlight films.",
      "Inline details with intact posters.",
      "Explicit save, pending, saved and error states."
    ],
    "rules": [
      {
        "name": "The Open Film Rule",
        "body": "Film entries sit directly on the ground; keep their title, facts and actions outside the poster frame.",
        "section": "elevation"
      },
      {
        "name": "The Intact Poster Rule",
        "body": "Contain catalog artwork in its frame and retain the title fallback when the image is unavailable.",
        "section": "layout"
      },
      {
        "name": "The Quiet Motion Rule",
        "body": "Pause ambient movement when the visitor interacts; disable animation and transitions for reduced motion.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use Manrope for identity and headings and DM Sans for controls and reading text.",
      "Do preserve visible keyboard focus, explicit detail close controls, Escape dismissal and focus return.",
      "Do keep factual metadata and explanations beneath the poster and preserve required TMDB credits.",
      "Do use the same film presentation in Discover and My collection."
    ],
    "donts": [
      "Don't crop portrait artwork to fill a landscape comparison frame.",
      "Don't wrap each film entry in another raised card or add decorative shadows.",
      "Don't hide warnings about unchecked requirements in visual decoration.",
      "Don't continue ambient animation after interaction or when reduced motion is requested."
    ]
  }
}
