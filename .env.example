# Keep the real key in .env, which is ignored by git.
OPENAI_API_KEY=
# Optional OpenAI-compatible service endpoint, primarily for tests.
OPENAI_BASE_URL=https://api.openai.com/v1

# TMDB API Read Access Token (Bearer token, not a v3 API key).
# Complete the account/API terms preflight before live ingestion.
TMDB_READ_TOKEN=
# Host CLI only; Compose retains snapshots in its tmdb-snapshots volume.
# TMDB_SNAPSHOT_DIR=var/snapshots
